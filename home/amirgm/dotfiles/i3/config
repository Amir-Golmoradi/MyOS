# ============================================================
# i3 CONFIGURATION
# Arch Linux | i3 | X11 | Fish
# Theme: Catppuccin Mocha
# ============================================================

# ------------------------------------------------------------
# GENERAL
# ------------------------------------------------------------

set $mod Mod4

for_window [class="^.*"] border pixel 1

font pango:JetBrainsMono Nerd Font 15
floating_modifier $mod


# ------------------------------------------------------------
# STARTUP
# ------------------------------------------------------------

# Compositor
exec --no-startup-id picom

# Wallpaper
exec --no-startup-id ~/.config/i3-theme/modules/wallpaper/session.sh

# Xresources
exec --no-startup-id xrdb -merge ~/.Xresources

# Keyboard:
# English + Persian
# Super + Space switches layouts
# Caps Lock retains its normal behavior
exec --no-startup-id setxkbmap -layout us,ir -option '' -option grp:win_space_toggle

# Super alone generates F1
# Restart xcape safely on i3 reload
exec_always --no-startup-id sh -c 'pkill -x xcape 2>/dev/null || true; xcape -e "Super_L=F1;Super_R=F1" &'

# kill any hanging polybar processes
exec_always killall polybar
exec_always --no-startup-id ~/.config/polybar/launch_polybar.sh

# XDG autostart
# Also launches Blueman's XDG autostart applet
exec --no-startup-id dex --autostart --environment i3

# Screen lock
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Network Manager applet
exec --no-startup-id nm-applet
# Super + Shift + N: Network settings
bindsym $mod+Shift+n exec --no-startup-id nm-connection-editor

# ------------------------------------------------------------
# APPLICATION LAUNCHERS
# ------------------------------------------------------------

# Terminal
bindsym $mod+Return exec --no-startup-id kitty

# File Manager 
bindsym $mod+e exec --no-startup-id kitty -e elio

# Super alone: fullscreen window overview

# Super + Space: floating application grid

# Super + D: centered Catppuccin dmenu
bindsym --release $mod+d exec --no-startup-id ~/.local/bin/i3-theme-dmenu

# Super + T: Throne
bindsym $mod+t exec --no-startup-id v2rayn

# Super + F: Firefox
bindsym $mod+f exec --no-startup-id firefox 

# Super + I: IntelliJ IDEA
bindsym $mod+i exec --no-startup-id /home/amirgm/.local/share/JetBrains/Toolbox/scripts/idea

# Super + Shift + B: Blueman Bluetooth Manager
bindsym $mod+Shift+b exec --no-startup-id blueman-manager

# Super + Tab: alternative window switcher

# Print Screen: Screenshot to clipboard
bindsym Print exec --no-startup-id maim -s | xclip -selection clipboard -t image/png -i

# Super + L: request a lock through the running xss-lock listener
bindsym $mod+l exec --no-startup-id loginctl lock-session

# Lock after 5 minutes of inactivity
exec --no-startup-id xset s 300 300

# ------------------------------------------------------------
# GNOME-STYLE ALT + TAB
# ------------------------------------------------------------

# Launch Rofi when Tab is released while Alt is held.
# Keep holding Alt and press Tab to move forward.
# Alt + Shift + Tab moves backward.
# Releasing Alt accepts the selected window.



# ------------------------------------------------------------
# WINDOW CLOSING
# ------------------------------------------------------------

# Ctrl + Q: close focused window
bindsym Control+q kill

# Alternative close shortcut
bindsym $mod+Shift+q kill


# ------------------------------------------------------------
# FULLSCREEN
# ------------------------------------------------------------

# Super + Shift + F
bindsym $mod+Shift+f fullscreen toggle


# ------------------------------------------------------------
# SCREENSHOTS
# ------------------------------------------------------------

# Full screenshot

# Active window screenshot
bindsym $mod+Print exec maim --window $(xdotool getactivewindow) "/home/$USER/Pictures/$(date).jpg"

# Select screenshot area
bindsym Shift+Print exec maim --select "/home/$USER/Pictures/$(date).jpg"

# Clipboard screenshots
bindsym Ctrl+Print exec maim | xclip -selection clipboard -t image/png

bindsym Ctrl+$mod+Print exec maim --window $(xdotool getactivewindow) | xclip -selection clipboard -t image/png

bindsym Ctrl+Shift+Print exec maim --select | xclip -selection clipboard -t image/png

exec --no-startup-id udiskie --no-tray

# ------------------------------------------------------------
# AUDIO CONTROLS
# ------------------------------------------------------------

set $refresh_i3status killall -SIGUSR1 i3status

bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status

bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status

bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status

bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status


# ------------------------------------------------------------
# BRIGHTNESS
# ------------------------------------------------------------

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%

bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-


# ------------------------------------------------------------
# WINDOW MANAGEMENT
# ------------------------------------------------------------

# Container layouts
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
# Tiling / floating
bindsym $mod+Shift+space floating toggle

# Focus parent
bindsym $mod+a focus parent


# ------------------------------------------------------------
# WINDOW FOCUS
# ------------------------------------------------------------

# Vim-style navigation
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+semicolon focus right

# Arrow keys
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right


# ------------------------------------------------------------
# MOVE WINDOWS
# ------------------------------------------------------------

# Vim-style navigation
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Arrow keys
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right


# ------------------------------------------------------------
# WORKSPACES
# ------------------------------------------------------------

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused window to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10


# ------------------------------------------------------------
# RESIZE MODE
# ------------------------------------------------------------

mode "resize" {
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"


# ------------------------------------------------------------
# I3 CONTROLS
# ------------------------------------------------------------

# Reload configuration
bindsym $mod+Shift+c reload

# Restart i3
bindsym $mod+Shift+r restart

# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"


# ============================================================
# CATPPUCCIN MOCHA
include ~/.config/i3/themes/current.conf
# ============================================================



# Super + Shift + T: Toggle light/dark theme
#bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/i3-theme-toggle

# Window colors
# class                 border     background text     indicator  child_border



bindsym Mod1+Tab focus right

# Toggle all desktop colors: Catppuccin Mocha <-> Latte
bindsym $mod+Shift+t exec --no-startup-id ~/.local/bin/i3-theme toggle
# Lightweight X11 GTK settings daemon (only starts if installed)
exec --no-startup-id ~/.config/i3-theme/modules/gtk/session.sh
